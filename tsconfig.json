{
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "styled-system/*": ["./styled-system/*"],
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "styled-system", "panda.config.ts", "vite.config.ts", "oxlint.config.ts"]
}
